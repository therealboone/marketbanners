# Database (Railway Postgres — reference from the Postgres service)
# In Railway: App service → Variables → Add Reference → Postgres.DATABASE_URL
# Local: use Neon, local Postgres, or `npx prisma dev`
DATABASE_URL="postgresql://user:password@host:5432/railway"

# Auth (generate with: openssl rand -base64 32)
AUTH_SECRET="your-auth-secret-here"
SETUP_SECRET="your-setup-secret-here"

# App URL (used for share links and invite URLs)
# Local: http://localhost:3000 | Production: https://your-app.up.railway.app or custom domain
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cloudflare R2
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_ACCESS_KEY="your-r2-secret-key"
R2_BUCKET_NAME="your-exact-bucket-name"
R2_PUBLIC_URL="https://pub-xxxxx.r2.dev"
# Optional: use Cloudflare REST API instead of S3 API (workaround for S3 TLS handshake failures)
# Create at: My Profile → API Tokens → Custom token → Account → Workers R2 Storage → Edit
# CLOUDFLARE_API_TOKEN="your-cloudflare-api-token"
# Optional: only if default endpoint fails (e.g. EU jurisdiction)
# R2_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
